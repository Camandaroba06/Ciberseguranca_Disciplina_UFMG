    {
      "id": "CQq0gYjf4rbNBiuHnEU57",
      "type": "text",
      "x": 1270.0056090355793,
      "y": 1744.6578308199123,
      "width": 660.0870124568859,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNG",
      "roundness": null,
      "seed": 652974849,
      "version": 621,
      "versionNonce": 1530420780,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "Aqui ele define: Um método busca a \"Interpretabilidade Agêntica\"\nse auxiliar provativamente a compreensão humana em um processo\ninterativo de múltiplas etapas, desenvolvendo e aproveitando um\nmodelo mental do usuário, o que, por usa vez, permite que os\nhumanos desenvolvam melhores modelos mentais do LLM.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Aqui ele define: Um método busca a \"Interpretabilidade Agêntica\" se auxiliar provativamente a compreensão humana em um processo interativo de múltiplas etapas, desenvolvendo e aproveitando um modelo mental do usuário, o que, por usa vez, permite que os humanos desenvolvam melhores modelos mentais do LLM.",
      "autoResize": false,
      "lineHeight": 1.25
    },
