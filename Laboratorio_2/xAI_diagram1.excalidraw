      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOa",
      "roundness": null,
      "seed": 355232552,
      "version": 583,
      "versionNonce": 1720032428,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "\"case learn\" as pessoas estão\naprendendo com as máquinas e as\nmáquinas aprendendo como ensinar\nmelhor os humanos",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\"case learn\" as pessoas estão aprendendo com as máquinas e as máquinas aprendendo como ensinar melhor os humanos",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "LEhi1d3NWyaqeuHVT3Fhw",
      "type": "text",
      "x": 1547.3775868372904,
      "y": 6634.109819680361,
      "width": 590.93673873963,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bOb",
      "roundness": null,
      "seed": 1709869608,
      "version": 610,
      "versionNonce": 1672533012,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "Como modelos mentais se relacionam ? Infelizmente isso é\nimpossível de medir, mas podemos aproximar ao usarmos\nmétricas de fim de curso (a máquina melhorou como\nqueriamos ? os humanos preveem o comportamento da\nmáquina melhor ?)",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Como modelos mentais se relacionam ? Infelizmente isso é impossível de medir, mas podemos aproximar ao usarmos métricas de fim de curso (a máquina melhorou como queriamos ? os humanos preveem o comportamento da máquina melhor ?)",
      "autoResize": false,
      "lineHeight": 1.25
    },
