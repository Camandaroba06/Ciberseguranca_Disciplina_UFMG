      "versionNonce": 33730348,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "Essas dificuldades levam a pensar em 2 possíveis abordagens: ",
      "fontSize": 20,
