      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "Mostra na 5.1 e 5.2 que é possível classificar esse sucesso e falha",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Mostra na 5.1 e 5.2 que é possível classificar esse sucesso e falha",
      "autoResize": true,
      "lineHeight": 1.25
    },
