    {
      "id": "JWn2ligGzHUBxuy9h71zr",
      "type": "text",
      "x": 5446.4037528120725,
      "y": 3517.549384960554,
      "width": 650.5595703125,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQR",
      "roundness": null,
      "seed": 958859048,
      "version": 125,
      "versionNonce": 1545782316,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "No final da página, os autores fazem uma observação crítica: essa\npontuação matemática é, na verdade, um limite superior (um cenário\notimista).",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "No final da página, os autores fazem uma observação crítica: essa pontuação matemática é, na verdade, um limite superior (um cenário otimista).",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "OpFEcv4QuN6XeaKo_wSyL",
      "type": "text",
      "x": 5409.893804081604,
      "y": 3590.049384960554,
      "width": 723.5794677734375,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bQS",
      "roundness": null,
      "seed": 370040664,
      "version": 125,
      "versionNonce": 2138825876,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "Se o modelo usa a dica e não fala, ele é claramente infiel (desonesto). No\nentanto, se ele verbaliza a dica, isso não significa necessariamente que ele\nestá sendo 100% transparente, pois ele ainda pode ter outras intenções\nocultas importantes que continuam sem ser declaradas no texto.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Se o modelo usa a dica e não fala, ele é claramente infiel (desonesto). No entanto, se ele verbaliza a dica, isso não significa necessariamente que ele está sendo 100% transparente, pois ele ainda pode ter outras intenções ocultas importantes que continuam sem ser declaradas no texto.",
      "autoResize": false,
      "lineHeight": 1.25
    },
