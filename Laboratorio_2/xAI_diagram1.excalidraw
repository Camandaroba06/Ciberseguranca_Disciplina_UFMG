    {
      "id": "ncNsI0-l4B4RPciWLvHt2",
      "type": "text",
      "x": 1714.0207573274397,
      "y": 1226.454648450242,
      "width": 680.8394775390625,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bN5",
      "roundness": null,
      "seed": 1381280655,
      "version": 252,
      "versionNonce": 405023124,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "1) Usar outra(s) LLMs no lugar desses humanos, para elas fingirem ser\nhumanos para conversarem entre si;",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "1) Usar outra(s) LLMs no lugar desses humanos, para elas fingirem ser humanos para conversarem entre si;",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "gDc4YGFvKc2K5UzIzDDe0",
      "type": "text",
      "x": 1712.522559323811,
      "y": 1302.3483328674474,
      "width": 690.5777648140428,
      "height": 75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bN6",
      "roundness": null,
      "seed": 1772689601,
      "version": 366,
      "versionNonce": 180087212,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "2) Focar no resultado final, ou seja, se o modelo consegue explicar\nbem ao metrificar se \"No fim do processo o humano conseguiu entender\nmais de um código dele ? debbugar mais rápido, por exemplo ?\"",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2) Focar no resultado final, ou seja, se o modelo consegue explicar bem ao metrificar se \"No fim do processo o humano conseguiu entender mais de um código dele ? debbugar mais rápido, por exemplo ?\"",
      "autoResize": false,
      "lineHeight": 1.25
    },
