    {
      "id": "YsmEB25CYZgy7J0kdA7sP",
      "type": "text",
      "x": 1151.9319539929463,
      "y": 4150.9634494797865,
      "width": 783.739501953125,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bNy",
      "roundness": null,
      "seed": 358077839,
      "version": 123,
      "versionNonce": 440988972,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "Eles admitem que o método agêntico depende de a IA ser cooperativa. Se o\nmodelo for propositalmente mentiroso ou desalinhado, a IA poderia sutilmente\nenganar o usuário durante a conversa. Nesses casos de alto risco (como auditar\nmodelos por segurança), a abordagem tradicional (inspetiva/mecanística) é a\nferramenta correta. No entanto, eles lembram que fazer uma \"cirurgia aberta do\nmodelo\" (obrigar a IA a conversar enquanto o humano manipula seus estados\ninternos) ainda pode revelar se ela está tentando mentir.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Eles admitem que o método agêntico depende de a IA ser cooperativa. Se o modelo for propositalmente mentiroso ou desalinhado, a IA poderia sutilmente enganar o usuário durante a conversa. Nesses casos de alto risco (como auditar modelos por segurança), a abordagem tradicional (inspetiva/mecanística) é a ferramenta correta. No entanto, eles lembram que fazer uma \"cirurgia aberta do modelo\" (obrigar a IA a conversar enquanto o humano manipula seus estados internos) ainda pode revelar se ela está tentando mentir.",
      "autoResize": false,
      "lineHeight": 1.25
    },
