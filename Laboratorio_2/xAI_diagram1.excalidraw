    {
      "id": "AxEx_aReVD3oqpFVaDXp1",
      "type": "text",
      "x": 5444.048275251412,
      "y": 870.0503221209882,
      "width": 575.7145685320365,
      "height": 123.2124243105402,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
