    {
      "id": "DHmglSBg3vjUJD8V7-R0_",
      "type": "text",
      "x": 10020.715539495219,
      "y": 1894.0925042867987,
      "width": 248.95151899658845,
      "height": 38.27671868352081,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
