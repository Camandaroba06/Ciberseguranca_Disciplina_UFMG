      "seed": 1865818200,
      "version": 900,
      "versionNonce": 738623788,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "Testaram outra forma de\naprendizado por reforço.\nIncentivando o modelo a\nresolver tarefas difíceis, ao\nrecompensar apenas a\nresolução de tarefas\ndifíceis. Notou-se uma\nmelhora da fidelidade no\ncomeço, mas logo depois\natinge um plato não\nchegando a 100% de\nfidelidade, ainda sendo um\nproblema.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Testaram outra forma de aprendizado por reforço. Incentivando o modelo a resolver tarefas difíceis, ao recompensar apenas a resolução de tarefas difíceis. Notou-se uma melhora da fidelidade no começo, mas logo depois atinge um plato não chegando a 100% de fidelidade, ainda sendo um problema.",
      "autoResize": false,
      "lineHeight": 1.25
    },
