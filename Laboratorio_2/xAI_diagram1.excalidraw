    {
      "id": "Ch9BXGww5ftvr1brdHHBN",
      "type": "text",
      "x": 1166.7789402793476,
      "y": 7505.2243852428455,
      "width": 266.7615962221596,
      "height": 386.82624475519697,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bP1",
      "roundness": null,
      "seed": 131941208,
      "version": 1086,
      "versionNonce": 1337062828,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1787416915649,
      "link": null,
      "locked": false,
      "text": "Modelos não sabem pq eles\nacertam ou erram. Estamos\nacostumados a achar que a\nIA sabe de tudo, mas não.\nUma IA não sabe que ela\npode ser ruim em ler textos\nlongos, ela não vai avisar\nisso do nada. A ideia é tipo\nde falantes nativos: Eu falo\nmuito bem português, mas\nse me perguntarem o pq de\numa certa frase minha estar\nperfeita ou não, não\nlembrarei os termos\ngramaticais/regras e etc da\nlíngua.",
      "fontSize": 19.341312237759848,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Modelos não sabem pq eles acertam ou erram. Estamos acostumados a achar que a IA sabe de tudo, mas não. Uma IA não sabe que ela pode ser ruim em ler textos longos, ela não vai avisar isso do nada. A ideia é tipo de falantes nativos: Eu falo muito bem português, mas se me perguntarem o pq de uma certa frase minha estar perfeita ou não, não lembrarei os termos gramaticais/regras e etc da língua.",
      "autoResize": false,
      "lineHeight": 1.25
    },
