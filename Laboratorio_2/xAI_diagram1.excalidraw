    {
      "id": "pXoP-ou4G-jqQTFA3x1PO",
      "type": "text",
      "x": 5387.850603842345,
      "y": 1241.552611398161,
      "width": 276.65072084774124,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
